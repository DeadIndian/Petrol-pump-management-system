// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles enum for role-based access control
enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
}

// Fuel types
enum FuelType {
  PETROL
  DIESEL
}

// Order status flow: pending → delivered → completed
enum OrderStatus {
  PENDING
  DELIVERED
  COMPLETED
}

// Payment method
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  OTHER
}

// Users table - stores all users (customers, employees, admins)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  fullName  String   @map("full_name")
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  orders        Order[]
  fulfilledOrders Order[] @relation("FulfilledBy")
  pricesCreated FuelPrice[] @relation("CreatedByAdmin")
  auditLogs     AuditLog[]
  customerProfile CustomerProfile?

  @@index([email])
  @@index([role])
  @@map("users")
}

// Customer Profile - stores customer-specific data including balance
model CustomerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  currentBalance  Float    @default(0) @map("current_balance") // Negative = customer owes, Positive = credit
  totalOrders     Int      @default(0) @map("total_orders")
  totalPurchases  Float    @default(0) @map("total_purchases") // Lifetime purchase amount
  totalPayments   Float    @default(0) @map("total_payments") // Lifetime payments made
  
  // Indent tracking
  indentStart     Int?     @map("indent_start")
  indentEnd       Int?     @map("indent_end")
  currentIndent   Int?     @map("current_indent")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@map("customer_profiles")
}

// Orders table - main order management
model Order {
  id                    String      @id @default(cuid())
  customerId            String      @map("customer_id")
  vehicleNumber         String      @map("vehicle_number")
  indentNumber          Int?        @map("indent_number")
  fuelType              FuelType    @map("fuel_type")
  amountRequested       Float?      @map("amount_requested") // Amount in INR if customer pays by amount
  quantityRequested     Float?      @map("quantity_requested") // Quantity in liters if customer pays by quantity
  cash                  Int         @default(0) // Extra cash added to total cost (in INR)
  quantityDelivered     Float?      @map("quantity_delivered") // Actual quantity delivered
  pricePerLiter         Float?      @map("price_per_liter") // Price at time of delivery
  totalAmount           Float?      @map("total_amount") // quantityDelivered * pricePerLiter
  status                OrderStatus @default(PENDING)
  deliveredAt           DateTime?   @map("delivered_at")
  completedAt           DateTime?   @map("completed_at")
  fulfilledById         String?     @map("fulfilled_by_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // Relations
  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fulfilledBy User? @relation("FulfilledBy", fields: [fulfilledById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@unique([customerId, indentNumber])
  @@index([fulfilledById])
  @@index([vehicleNumber])
  @@index([status])
  @@index([deliveredAt])
  @@index([createdAt])
  @@map("orders")
}

// Fuel prices table - daily price management
model FuelPrice {
  id            String   @id @default(cuid())
  fuelType      FuelType @map("fuel_type")
  pricePerLiter Float    @map("price_per_liter")
  date          DateTime // Date for which the price applies
  createdByAdminId String @map("created_by_admin_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  createdByAdmin User @relation("CreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@unique([fuelType, date]) // One price per fuel type per day
  @@index([date])
  @@index([fuelType])
  @@map("fuel_prices")
}

// Payment table - track customer payments
model Payment {
  id                String         @id @default(cuid())
  customerProfileId String         @map("customer_profile_id")
  amount            Float          // Payment amount (positive)
  paymentMethod     PaymentMethod? @map("payment_method")
  paymentMethodNote String?        @map("payment_method_note") // Additional notes about payment method
  reference         String?        // Payment reference number (cheque/transaction ID)
  notes             String?        // Additional notes
  paymentDate       DateTime       @default(now()) @map("payment_date")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
  @@index([paymentDate])
  @@index([createdAt])
  @@map("payments")
}

// Audit logs table - track admin actions
model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String   // e.g., "PRICE_UPDATE", "BILL_GENERATED", etc.
  tableName String   @map("table_name") // e.g., "fuel_prices", "bills"
  recordId  String?  @map("record_id") // ID of the affected record
  changes   String   // JSON string of what changed
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Petrosoft is isolated from the existing delivery application's data and auth.
model PetrosoftWorkspace {
  id            String   @id @default(cuid())
  referenceCode String   @unique @map("reference_code")
  name          String
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  users         PetrosoftUser[]
  entries       PetrosoftEntry[]
  sequences     PetrosoftSequence[]
  attachments   PetrosoftAttachment[]
  audits        PetrosoftAudit[]
  nativeRecords PetrosoftNativeRecord[]

  @@map("petrosoft_workspaces")
}

model PetrosoftUser {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  username     String
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  role         String   @default("Super Admin")
  permissions  Json     @default("[\"*\"]")
  active       Boolean  @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  workspace    PetrosoftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions     PetrosoftSession[]

  @@unique([workspaceId, username])
  @@map("petrosoft_users")
}

model PetrosoftSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      PetrosoftUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("petrosoft_sessions")
}

model PetrosoftSequence {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  module      String
  value       Int    @default(0)
  workspace   PetrosoftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, module])
  @@map("petrosoft_sequences")
}

model PetrosoftEntry {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  module      String
  number      Int
  externalId  String?  @map("external_id")
  name        String   @default("")
  date        DateTime @db.Date
  amount      Decimal  @default(0) @db.Decimal(18, 4)
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  rate        Decimal  @default(0) @db.Decimal(18, 4)
  status      String   @default("active")
  fields      Json     @default("{}")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workspace   PetrosoftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ledger      PetrosoftLedger[]

  @@unique([workspaceId, module, number])
  @@unique([workspaceId, module, externalId])
  @@index([workspaceId, module, date])
  @@map("petrosoft_entries")
}

model PetrosoftLedger {
  id          String   @id @default(cuid())
  entryId     String   @map("entry_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  date        DateTime @db.Date
  debit       Decimal  @default(0) @db.Decimal(18, 4)
  credit      Decimal  @default(0) @db.Decimal(18, 4)
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  description String   @default("")
  entry       PetrosoftEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, date])
  @@map("petrosoft_ledger")
}

model PetrosoftAttachment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  module      String   @default("organization")
  filename    String
  contentType String   @map("content_type")
  storageName String   @unique @map("storage_name")
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")
  workspace   PetrosoftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("petrosoft_attachments")
}

model PetrosoftAudit {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  username    String
  action      String
  module      String
  entryId     String?  @map("entry_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")
  workspace   PetrosoftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("petrosoft_audits")
}

// Supplementary native records retain calibration charts, vehicles and historical
// stock snapshots without mixing imported SQL or private provider credentials into code.
model PetrosoftNativeRecord {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  tableName   String   @map("table_name")
  nativeId    String   @map("native_id")
  fields      Json
  workspace   PetrosoftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, tableName, nativeId])
  @@index([workspaceId, tableName])
  @@map("petrosoft_native_records")
}
